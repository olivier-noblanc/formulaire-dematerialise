includes:
    - phpstan-baseline.neon
    - phpstan-rules.neon
parameters:
    level: 8
    paths:
        - src/
        - lib/
        - classes/
        - phpstan-rules/
        - helpers.php
        - config.php
        - index.php
        - assets.php
        - alert_check.php
        - remind.php
        - style.php
    excludePaths:
        - tests/*
        - vendor/*
        - router.php
        - install.php
    tmpDir: .phpstan-cache
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: shipmonk.deadMethod
            path: src/Contract/*
        -
            identifier: shipmonk.deadMethod
            path: src/Controller/*
        -
            identifier: shipmonk.deadMethod
            path: src/Render/DynamicCssService.php
    bootstrapFiles:
        - helpers.php
        - phpstan_inst_stubs.php
