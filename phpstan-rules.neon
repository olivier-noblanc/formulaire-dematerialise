services:
    -
        class: App\PHPStan\NoMagicStringRule
        tags:
            - phpstan.rules.rule
    -
        class: App\PHPStan\RequireBuildUrlForRedirectRule
        tags:
            - phpstan.rules.rule
    -
        class: App\PHPStan\NoUntypedArrayParameterRule
        tags:
            - phpstan.rules.rule
