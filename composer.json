{
    "name": "oliviernoblanc/formulaire-dematerialise",
    "description": "Formulaire dematerialise - Circuit de validation",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\PHPStan\\": "phpstan-rules/",
            "App\\Rector\\": "rector-rules/"
        }
    },
    "config": {
        "apcu-autoloader": false,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "infection/extension-installer": true,
            "phpro/grumphp": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/PHPUnit/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "*",
        "php-cs-fixer/shim": "^3.95",
        "rector/rector": "^2.5",
        "shipmonk/dead-code-detector": "^1.3",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-strict-rules": "*",
        "spaze/phpstan-disallowed-calls": "^4.13",
        "deptrac/deptrac": "^4.7",
        "infection/infection": "*",
        "phpro/grumphp": "^2.23",
        "shipmonk/phpstan-rules": "^4.4"
    }
}
