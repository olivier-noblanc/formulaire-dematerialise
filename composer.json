{
    "name": "oliviernoblanc/formulaire-dematerialise",
    "description": "Formulaire dematerialise - Circuit de validation",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "apcu-autoloader": false
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/PHPUnit/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "*",
        "php-cs-fixer/shim": "^3.95",
        "rector/rector": "^2.5",
        "shipmonk/dead-code-detector": "^1.3"
    }
}
