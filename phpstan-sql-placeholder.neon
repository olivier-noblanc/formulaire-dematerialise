# phpstan-sql-placeholder.neon — Détection des décalages entre placeholders
# '?' et arguments execute() (SqlPlaceholderCountRule)
parameters:
    customRulesetUsed: true
    level: 0
    paths:
        - src/
        - lib/
        - classes/
    excludePaths:
        - tests/*
        - vendor/*
        - src/Render/InstallRenderer.php
    tmpDir: /tmp/phpstan-sql-placeholder
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#^Loose comparison via "==" is not allowed\.$#'
        - '#^Construct empty\(\) is not allowed\.#'
        - '#^Short ternary operator is not allowed\.#'
        - '#^Function resolve_base_url not found\.#'
        - '#^Unused App\\#'
        - '#^Casting to .+ something that.s already .+\.$#'
        - '#^Call to function array_filter\(\) requires parameter \#2#'
        - '#^Foreach overwrites#'
        - '#^Only booleans are allowed in#'
        - '#^Loose comparison via#'
        - '#^Property App\\#'
        - '#^Function inst_#'

        - #^Array key must be integer or string, but .+ given\.0
        - #^Cannot compare different types in .+\.0
        - #^Comparison .+ contains non-comparable type#
        - #^Null value involved in binary operation:.+#
        - #^Using [+\-] over non-number#
        - #^Call to function iterator_to_array without 2nd parameter#
        - #^Closure parameter .+ is unused#
        - #^Public property .+ not marked as readonly#
        - #^Missing parameter typehint for arrow function parameter#
        - #^Missing native return typehint#
services:
    -
        class: App\PHPStan\SqlPlaceholderCountRule
        tags:
            - phpstan.rules.rule
