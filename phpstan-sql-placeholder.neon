# phpstan-sql-placeholder.neon — Détection des décalages entre placeholders
# '?' et arguments execute() (SqlPlaceholderCountRule)
parameters:
    customRulesetUsed: true
    level: 0
    paths:
        - src/
        - lib/
        - classes/
    excludePaths:
        - tests/*
        - vendor/*
    tmpDir: /tmp/phpstan-sql-placeholder
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#^Loose comparison via "==" is not allowed\.$#'
        - '#^execute\(\) re.*placeholder#'
        - '#^Construct empty\(\) is not allowed\.#'
        - '#^Short ternary operator is not allowed\.#'
        - '#^Function resolve_base_url not found\.#'

services:
    -
        class: App\PHPStan\SqlPlaceholderCountRule
        tags:
            - phpstan.rules.rule
