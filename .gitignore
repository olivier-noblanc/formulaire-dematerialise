# Dépendances PHP (seul vendor/autoload.php, vendor/composer/ et vendor/PHPMailer sont versionnés — serveur offline)
/vendor/*
!vendor/autoload.php
!vendor/composer/
!vendor/PHPMailer/

# Deptrac cache
.deptrac.cache

# Base de données SQLite
/db/*.db
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Fichiers de configuration sensibles
/config.php
/.env
/.env.local
/.env.production
/.env.staging

# Fichiers temporaires et cache
/tmp/
/cache/
*.tmp
*.log
*.log.err
/db/cache/
/.phpstan-cache/
/download/claude_cache.json

# Backups (générés par update.ps1)
/backups/
/backup-*.zip

# Sessions PHP
/sessions/

# Système de fichiers
.DS_Store
Thumbs.db
web.config

# IDE
.vscode/
.idea/
*.swp
*.swo

# Tests
/tool-results/
/spc
/worklog.md

# Code coverage
/coverage/
/coverage-html/
/coverage_html/

# PHPArkitect baseline
/phparkitect-baseline.json

# PHPUnit JUnit output (device name collision on Windows)
nul
/tests/tmp/

# Graphify
/graphify-out/

# MiMoCode
.mimocode/

# PHPUnit
/phpunit.phar
/.phpunit.result.cache

# Temporary files
/test_output*.txt
/requireAdmin()

# Temporary downloads
/pcov.zip
/composer-setup.php

# Node.js
node_modules/
package-lock.json

# Fichier temporaire
monofichier_code_source.php

# Accidental clones (agent-pulse mangled clone path)
agent-pulse/
Usersolivier*
.playwright-mcp/

# Fichiers LLM cache
edenai-llm-cache-pricing.*
