# phpstan-no-inline.neon — Détection des style=/onXxx=/<script> inline
# (NoInlineHtmlRule), séparée du job principal PHPStan (level 8) — celui-ci
# tourne depuis longtemps et reste vert avec sa baseline curée ; le volume
# réel de violations de cette nouvelle règle est inconnu tant qu'elle n'a
# pas tourné une fois en CI (cf. tests/phpstan.neon, même précaution prise
# le 2026-07-30 pour la même raison). Job dédié en continue-on-error au
# départ.
#
# customRulesetUsed: true — pas d'extensions auto-chargées (shipmonk,
# strict-rules...) : seule NoInlineHtmlRule doit remonter ici, pas de bruit
# d'un autre outil qui rendrait ce rapport illisible.
parameters:
    customRulesetUsed: true
    level: 0
    paths:
        - src/
        - lib/
    excludePaths:
        - tests/*
        - vendor/*
    tmpDir: /tmp/phpstan-no-inline
    reportUnmatchedIgnoredErrors: false

services:
    -
        class: App\PHPStan\NoInlineHtmlRule
        tags:
            - phpstan.rules.rule
