parameters:
    # Niveau volontairement différent de src/ (niveau 8) : les tests n'ont
    # pas les mêmes enjeux de typage strict que le code de production.
    # Décision explicite (2026-07-29), pas dans AGENTS.md à ce jour.
    level: 2
    paths:
        - .
    excludePaths:
        - docs/screenshots/*
        - db/*
        - cache/*
        - PHPMailer/*
        - node_modules/*
        - scripts/*
        - download/*
        - .git/*
        - *.bak
        # Fichiers de test exclus (polyfills mbstring, tests CLI)
        - test_refactor.php
        - test_v4.php
        - test_bootstrap.php
        - test_advanced.php
        - test_all.php
        - test_api.php
        - test_http.php
        - test_e2e.php
        - test_unit.php
    tmpDir: /tmp/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Call to static method PHPUnit\\Framework\\Assert::assertTrue\(\) with true will always evaluate to true\.$#'
            # Faux positif de phpstan-phpunit sur expectNotToPerformAssertions()
            # (idiome PHPUnit légitime pour "vérifie juste l'absence
            # d'exception" — pas un vrai assertTrue(true) écrit à la main).
    bootstrapFiles:
        - ../helpers.php
        - phpstan-test-functions.php
        - ../vendor/PHPMailer/src/PHPMailer.php
        - ../vendor/PHPMailer/src/Exception.php
        - ../vendor/PHPMailer/src/SMTP.php
