# Isolation de shipmonk/dead-code-detector (2026-07-30) : cette extension
# est auto-chargée par phpstan/extension-installer pour TOUTE analyse du
# projet (comportement global, pas configurable par fichier de config —
# vérifié sur phpstan.org/config-reference et le README de
# phpstan/extension-installer). Sans isolation, elle tourne une 2e fois
# ici en plus de l'analyse src/ (job "PHPStan (level 8)"), redondant et
# coûteux en mémoire sur l'ensemble de tests/ (collecte les usages sur
# tout le graphe d'appel). customRulesetUsed: true désactive TOUTES les
# extensions auto-chargées pour CE fichier uniquement — la configuration
# racine (phpstan.neon, src/) n'est pas touchée, shipmonk continue d'y
# tourner normalement.

parameters:
    customRulesetUsed: true

    level: 2
    paths:
        - .
    excludePaths:
        - docs/screenshots/*
        - db/*
        - cache/*
        - PHPMailer/*
        - node_modules/*
        - scripts/*
        - download/*
        - .git/*
        - *.bak
        - test_refactor.php
        - test_v4.php
        - test_bootstrap.php
        - test_advanced.php
        - test_all.php
        - test_api.php
        - test_http.php
        - test_e2e.php
        - test_unit.php
    tmpDir: /tmp/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#^Call to static method PHPUnit\\Framework\\Assert::assertTrue\(\) with true will always evaluate to true\.$#'
        - '#^Construct empty\(\) is not allowed\.#'
        - '#^Short ternary operator is not allowed\.#'
        - '#^Call to an undefined method ReflectionType::getName\(\)\.$#'
        - '#^Casting to .+ something that.s already .+\.$#'
        - '#^Dynamic call to static method PHPUnit\\Framework\\Assert::#'
        - '#^Variable \$.+ on left side of \?\? always exists#'
        - '#^Variable \$.+ might not be defined#'
        - '#^Property App\\Tests\\.+ \$\w+ is never written#'
        - '#^Only booleans are allowed in an if condition#'
        - '#^Variable \$http_response_header in isset\(\) always exists#'
        - '#^Call to an undefined method COM::Run\(\)\.$#'
        - '#^Unused DomAssertions::#'
        - '#^Only booleans are allowed in &&#'
        - '#^Call to function array_filter\(\) requires parameter \#2#'
        - '#^Foreach overwrites#'
        - '#^Loose comparison via#'
        - '#^Only booleans are allowed in a negated boolean#'
        - '#^Class App\\Webhook\\WebhookService does not have a constructor#'
        - '#^Call to function in_array\(\) requires parameter \#3#'
    bootstrapFiles:
        - ../helpers.php
        - phpstan-test-functions.php
        - ../vendor/PHPMailer/src/PHPMailer.php
        - ../vendor/PHPMailer/src/Exception.php
        - ../vendor/PHPMailer/src/SMTP.php
