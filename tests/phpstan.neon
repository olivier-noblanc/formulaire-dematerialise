# Isolation de shipmonk/dead-code-detector (2026-07-30) : cette extension
# est auto-chargée par phpstan/extension-installer pour TOUTE analyse du
# projet (comportement global, pas configurable par fichier de config —
# vérifié sur phpstan.org/config-reference et le README de
# phpstan/extension-installer). Sans isolation, elle tourne une 2e fois
# ici en plus de l'analyse src/ (job "PHPStan (level 8)"), redondant et
# coûteux en mémoire sur l'ensemble de tests/ (collecte les usages sur
# tout le graphe d'appel). customRulesetUsed: true désactive TOUTES les
# extensions auto-chargées pour CE fichier uniquement — la configuration
# racine (phpstan.neon, src/) n'est pas touchée, shipmonk continue d'y
# tourner normalement.
#
# Tentative avortée : réinclure explicitement phpstan-strict-rules/rules.neon
# pour garder ses vérifications ici aussi (appel statique, empty(),
# ternaire court...) — a fait planter le job sans détail exploitable
# (probablement %featureToggles.bleedingEdge%, une conditionalTag de la
# v2.x de ce paquet, normalement fournie par le chargement standard de
# extension-installer et absente ici). Retiré : plus risqué que la
# perte de ces vérifications pour tests/ ne le justifie.

parameters:
    customRulesetUsed: true

    # Niveau volontairement différent de src/ (niveau 8) : les tests n'ont
    # pas les mêmes enjeux de typage strict que le code de production.
    # Décision explicite (2026-07-29), pas dans AGENTS.md à ce jour.
    level: 2
    paths:
        - .
    excludePaths:
        - docs/screenshots/*
        - db/*
        - cache/*
        - PHPMailer/*
        - node_modules/*
        - scripts/*
        - download/*
        - .git/*
        - *.bak
        # Fichiers de test exclus (polyfills mbstring, tests CLI)
        - test_refactor.php
        - test_v4.php
        - test_bootstrap.php
        - test_advanced.php
        - test_all.php
        - test_api.php
        - test_http.php
        - test_e2e.php
        - test_unit.php
    tmpDir: /tmp/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Call to static method PHPUnit\\Framework\\Assert::assertTrue\(\) with true will always evaluate to true\.$#'
            # Faux positif de phpstan-phpunit sur expectNotToPerformAssertions()
            # (idiome PHPUnit légitime pour "vérifie juste l'absence
            # d'exception" — pas un vrai assertTrue(true) écrit à la main).
    bootstrapFiles:
        - ../helpers.php
        - phpstan-test-functions.php
        - ../vendor/PHPMailer/src/PHPMailer.php
        - ../vendor/PHPMailer/src/Exception.php
        - ../vendor/PHPMailer/src/SMTP.php

        # Baseline pour tests/ — erreurs pré-existantes (empty(), ternary,
        # dynamic call to static method, ReflectionType::getName())
        -
            message: '#^Construct empty\(\) is not allowed\. Use more strict comparison\.$#'
            identifier: empty.notAllowed
        -
            message: '#^Short ternary operator is not allowed\. Use null coalesce operator if applicable or consider using long ternary\.$#'
            identifier: ternary.shortNotAllowed
        -
            message: '#^Call to an undefined method ReflectionType::getName\(\)\.$#'
        -
            message: '#^Casting to int something that.s already int\.$#'
            identifier: cast.useless
        -
            message: '#^Dynamic call to static method PHPUnit\\Framework\\Assert::#'
