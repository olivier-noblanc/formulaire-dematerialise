# Isolation de shipmonk/dead-code-detector (2026-07-30) : cette extension
# est auto-chargée par phpstan/extension-installer pour TOUTE analyse du
# projet (comportement global, pas configurable par fichier de config —
# vérifié sur phpstan.org/config-reference et le README de
# phpstan/extension-installer). Sans isolation, elle tourne une 2e fois
# ici en plus de l'analyse src/ (job "PHPStan (level 8)"), redondant et
# coûteux en mémoire sur l'ensemble de tests/ (collecte les usages sur
# tout le graphe d'appel). customRulesetUsed: true désactive TOUTES les
# extensions auto-chargées pour CE fichier uniquement — la configuration
# racine (phpstan.neon, src/) n'est pas touchée, shipmonk continue d'y
# tourner normalement.

parameters:
    customRulesetUsed: true

    level: 2
    paths:
        - .
    excludePaths:
        - docs/screenshots/*
        - db/*
        - cache/*
        - PHPMailer/*
        - node_modules/*
        - scripts/*
        - download/*
        - .git/*
        - *.bak
        - test_refactor.php
        - test_v4.php
        - test_bootstrap.php
        - test_advanced.php
        - test_all.php
        - test_api.php
        - test_http.php
        - test_e2e.php
        - test_unit.php
    tmpDir: /tmp/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#^Call to static method PHPUnit\\Framework\\Assert::assertTrue\(\) with true will always evaluate to true\.$#'
        -
            message: '#^Construct empty\(\) is not allowed\.#'
        -
            message: '#^Short ternary operator is not allowed\.#'
        -
            message: '#^Call to an undefined method ReflectionType::getName\(\)\.$#'
        -
            message: '#^Casting to (int|string) something that.s already (int|string)\.$#'
        -
            message: '#^Dynamic call to static method PHPUnit\\Framework\\Assert::#'
        -
            message: '#^Variable \$.+ on left side of \?\? always exists#'
        -
            message: '#^Variable \$.+ might not be defined#'
        -
            message: '#^Property App\\Tests\\.+ \$\w+ is never written#'
    bootstrapFiles:
        - ../helpers.php
        - phpstan-test-functions.php
        - ../vendor/PHPMailer/src/PHPMailer.php
        - ../vendor/PHPMailer/src/Exception.php
        - ../vendor/PHPMailer/src/SMTP.php
