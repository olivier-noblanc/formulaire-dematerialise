#!/usr/bin/env bash
# =============================================================================
# pre-push — Hook git (versionné dans scripts/, installé dans .git/hooks/).
#
# Bloque le `git push` vers origin/master ou origin/dev si la gate qualité
# (scripts/gate.sh) échoue.
#
# Format du stdin (une ligne par ref poussée) :
#   <local ref> <local sha> <remote ref> <remote sha>
#
# Exemples :
#   refs/heads/master  abc123  refs/heads/master  def456
#   refs/heads/dev     abc123  refs/heads/dev     def456
#
# Pour bypasser (déconseillé) : `git push --no-verify`
#
# Installation : `bash scripts/install_hooks.sh`
# =============================================================================
set -euo pipefail

# ─── Couleurs ANSI ───────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    C_GREEN='\033[32m'; C_RED='\033[31m'; C_YELLOW='\033[33m'
    C_CYAN='\033[36m';  C_BOLD='\033[1m'; C_RESET='\033[0m'
else
    C_GREEN=''; C_RED=''; C_YELLOW=''; C_CYAN=''; C_BOLD=''; C_RESET=''
fi

# ─── Se positionner à la racine du projet ────────────────────────────────────
# Le hook est dans .git/hooks/, on remonte à la racine du working tree.
# `git rev-parse --show-toplevel` marche dans tous les cas (worktrees compris).
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$PROJECT_ROOT"

# ─── Branchements protégés ───────────────────────────────────────────────────
# On bloque si la ref distante (3e champ) correspond à master ou dev.
PROTECTED_REFS=("refs/heads/master" "refs/heads/dev")
NEED_GATE=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # remote_ref ressemble à "refs/heads/master"
    for protected in "${PROTECTED_REFS[@]}"; do
        if [[ "$remote_ref" == "$protected" ]]; then
            NEED_GATE=1
            break
        fi
    done
done

if [[ $NEED_GATE -eq 0 ]]; then
    # Pas un push vers master/dev → on laisse passer sans exécuter la gate.
    exit 0
fi

# ─── Exécuter la gate ────────────────────────────────────────────────────────
GATE_SCRIPT="scripts/gate.sh"
if [[ ! -f "$GATE_SCRIPT" ]]; then
    printf "${C_RED}[pre-push] Script gate.sh introuvable à : %s${C_RESET}\n" "$GATE_SCRIPT" >&2
    printf "${C_YELLOW}[pre-push] Pour bypasser (déconseillé) : git push --no-verify${C_RESET}\n" >&2
    exit 1
fi

printf "${C_BOLD}${C_CYAN}[pre-push] Push vers une branche protégée détecté — exécution de la gate qualité…${C_RESET}\n"
printf "${C_CYAN}[pre-push] Lancement : bash %s${C_RESET}\n\n" "$GATE_SCRIPT"

if bash "$GATE_SCRIPT"; then
    printf "\n${C_BOLD}${C_GREEN}[pre-push] Gate OK — push autorisé.${C_RESET}\n"
    exit 0
else
    rc=$?
    printf "\n${C_BOLD}${C_RED}[pre-push] Gate ÉCHEC (code %d) — push BLOQUÉ.${C_RESET}\n" "$rc" >&2
    printf "${C_YELLOW}[pre-push] Corrigez les erreurs ci-dessus puis recommencez.${C_RESET}\n" >&2
    printf "${C_YELLOW}[pre-push] Pour bypasser en urgence (déconseillé) : git push --no-verify${C_RESET}\n" >&2
    exit 1
fi
